# CMake build tree (also the regtest scratch root: build/regtests/<phase>)
build/
build*/

# GNUmake (AMReX build system)
*.ex
tmp_build_dir/

# AMReX crash artifacts
Backtrace.*

# Python
__pycache__/
*.pyc

# Packaging (pip install . builds under build/, which is covered above;
# `python -m build` and older tooling write these)
dist/
*.egg-info/
.pytest_cache/

# Real terrain (cases/). A downloaded 5x5 km SRTM tile is about a megabyte
# of text per case; survey.json carries what is needed to rebuild the grid
# and IS committed, so the catalogue stays reproducible without them.
cases/*/terrain.csv
cases/*/*.tif
cases/*/plt_*/

# The corpus (cases/corpus/). Each site's tile covers 10 km rather than 5,
# so it is nearer ten megabytes; the per-site survey.json holds every window's
# extremes, grid and descriptors and IS committed, which is what lets
# build_corpus.py --split and tests/test_corpus.py run with no tiles at all.
cases/corpus/*/tile.csv
cases/corpus/*/*.tif
cases/corpus/*/plt_*/

# Sphinx
docs/_build/

# Generated datasets (cases/build_dataset.py). The corpus at nine levels is
# a couple of gigabytes; the manifest and the code that makes it are what
# is worth committing.
data/
