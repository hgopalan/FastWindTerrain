# CMake build tree (also the regtest scratch root: build/regtests/<phase>)
build/
build*/

# GNUmake (AMReX build system)
*.ex
tmp_build_dir/

# AMReX crash artifacts
Backtrace.*

# Python
__pycache__/
*.pyc

# Packaging (pip install . builds under build/, which is covered above;
# `python -m build` and older tooling write these)
dist/
*.egg-info/
.pytest_cache/

# Real terrain (cases/). A downloaded 5x5 km SRTM tile is about a megabyte
# of text per case; survey.json carries what is needed to rebuild the grid
# and IS committed, so the catalogue stays reproducible without them.
cases/*/terrain.csv
cases/*/*.tif
cases/*/plt_*/

# Sphinx
docs/_build/
