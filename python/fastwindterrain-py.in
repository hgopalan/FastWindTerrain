#!/bin/sh
# Generated by CMake -- do not edit.
#
# An argv-compatible stand-in for the solver executable that runs the
# case through the Python bindings instead. Everything downstream sees
# the same interface, so the regtest driver can run the entire suite
# through Python unchanged:
#
#     python3 run_regtests.py build/fastwindterrain-py
#
# and every output file it produces should be byte-identical to the one
# the executable produces.
PYTHONPATH="@CMAKE_BINARY_DIR@/python${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "@Python3_EXECUTABLE@" -m fastwindterrain "$@"
