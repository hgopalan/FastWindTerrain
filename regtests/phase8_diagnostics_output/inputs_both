# Phase 8 regtest -- diagnostics and the two output backends.
#
# A Phase 6/7 case at a smaller size: a 100 m hill, a sheared powerlaw
# inflow, anisotropy and O'Brien both on, four projection passes. Every
# field the output carries is therefore something other than a constant,
# which is what makes the plt-versus-ascii comparison worth running.
#
# The grid is deliberately small. output.format = both writes one
# plain-text row per cell at full double precision, and that file is
# roughly 450 bytes a cell -- a regtest aid, not a production path.
# The checker overrides terrain.file with an absolute path.

grid.n_cell           = 24 24 40
grid.prob_lo          = 0.0 0.0 0.0
grid.prob_hi          = 1000.0 1000.0 483.19909696997223
grid.dz0              = 4.0
grid.stretching_ratio = 1.05
grid.max_grid_size    = 16

terrain.file = terrain_hill.csv

inflow.mode              = powerlaw
inflow.u_ref             = 8.0
inflow.v_ref             = 6.0
inflow.z_ref             = 10.0
inflow.powerlaw_exponent = 0.14

anisotropy.enable       = 1
anisotropy.source       = slope
anisotropy.alpha_h_mode = base

obrien.enable = 1

poisson.alpha_h       = 1.0
poisson.alpha_v       = 0.5
poisson.n_projections = 4

# report + fields, and the fields in BOTH backends so the checker can
# compare them cell by cell.
grid.output_format = both
grid.report_file   = grid_report_both.txt
grid.plot_file     = plt_both

output.format     = both
output.ascii_file = fields_both.txt
