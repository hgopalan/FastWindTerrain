# Phase 5 regtest -- assembled RHS against an independent divergence.
#
# A hill makes u0 genuinely non-solenoidal: the profile is anchored to
# height above ground, so it varies horizontally wherever the terrain
# does, and div(u0) is nonzero. Over flat ground the same profile is
# exactly solenoidal and the RHS would be identically zero, which would
# test nothing.
#
# alpha_h and alpha_v differ so the anisotropy is visible in sigma, and
# the vertical grid is stretched so the metric is exercised.
# The checker overrides terrain.file with an absolute path.

grid.n_cell           = 40 40 66
grid.prob_lo          = 0.0 0.0 0.0
grid.prob_hi          = 1000.0 1000.0 961.2758234855
grid.dz0              = 2.0
grid.stretching_ratio = 1.05
grid.max_grid_size    = 32

terrain.file = terrain_hill.csv

inflow.mode              = powerlaw
inflow.u_ref             = 8.0
inflow.v_ref             = 6.0
inflow.z_ref             = 10.0
inflow.powerlaw_exponent = 0.14

poisson.alpha_h = 1.0
poisson.alpha_v = 0.5

grid.output_format    = both
grid.report_file      = grid_report_rhs.txt
grid.plot_file        = plt_rhs
poisson.rhs_dump_file = rhs_dump.txt
