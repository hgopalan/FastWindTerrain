# Phase 4 regtest -- wind from the south-west.
# (u_ref, v_ref) points toward +x and +y, so the wind enters through xlo
# and ylo and leaves through xhi and yhi.
#
#   xlo, ylo -> inflow   (velocity prescribed, lambda Neumann)
#   xhi, yhi -> outflow  (zero gradient,       lambda Dirichlet)

grid.n_cell           = 40 40 66
grid.prob_lo          = 0.0 0.0 0.0
grid.prob_hi          = 1000.0 1000.0 961.2758234855
grid.dz0              = 2.0
grid.stretching_ratio = 1.05
grid.max_grid_size    = 32

inflow.mode              = powerlaw
inflow.u_ref             = 8.0
inflow.v_ref             = 6.0
inflow.z_ref             = 10.0
inflow.powerlaw_exponent = 0.14

grid.output_format    = both
grid.report_file      = grid_report_sw.txt
grid.plot_file        = plt_sw
bc.dump_file          = bc_dump_sw.txt
