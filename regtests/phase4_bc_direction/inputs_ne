# Phase 4 regtest -- wind from the north-east, the exact opposite of
# inputs_sw. Every lateral face must swap its classification.
#
#   xhi, yhi -> inflow   (velocity prescribed, lambda Neumann)
#   xlo, ylo -> outflow  (zero gradient,       lambda Dirichlet)

grid.n_cell           = 40 40 66
grid.prob_lo          = 0.0 0.0 0.0
grid.prob_hi          = 1000.0 1000.0 961.2758234855
grid.dz0              = 2.0
grid.stretching_ratio = 1.05
grid.max_grid_size    = 32

inflow.mode              = powerlaw
inflow.u_ref             = -8.0
inflow.v_ref             = -6.0
inflow.z_ref             = 10.0
inflow.powerlaw_exponent = 0.14

grid.output_format    = both
grid.report_file      = grid_report_ne.txt
grid.plot_file        = plt_ne
bc.dump_file          = bc_dump_ne.txt
