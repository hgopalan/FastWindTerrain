# Phase 6 regtest -- flat-terrain control case.
#
# A horizontally uniform profile over flat ground is already solenoidal,
# so there is nothing for the projection to do: lambda must come out
# essentially zero and the corrected velocity must equal u0. This is the
# case that catches a projection which "corrects" a field that was
# already fine.

grid.n_cell           = 32 32 48
grid.prob_lo          = 0.0 0.0 0.0
grid.prob_hi          = 1000.0 1000.0 417.63358390135323
grid.dz0              = 4.0
grid.stretching_ratio = 1.03
grid.max_grid_size    = 32

inflow.mode              = powerlaw
inflow.u_ref             = 8.0
inflow.v_ref             = 6.0
inflow.z_ref             = 10.0
inflow.powerlaw_exponent = 0.14

poisson.alpha_h = 1.0
poisson.alpha_v = 1.0

grid.output_format = ascii
grid.report_file   = grid_report_flat.txt
