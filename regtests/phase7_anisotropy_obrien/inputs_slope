# Phase 7 regtest -- sloped terrain with cell-local anisotropy and the
# O'Brien vertical-velocity adjustment.
#
# The hill is deliberately steep (150 m over a 120 m width) so the slope
# factor has something to bite on: alpha_v must be suppressed well below
# its base value on the flanks while staying at base over flat ground.
# The checker overrides terrain.file with an absolute path.

grid.n_cell           = 40 40 66
grid.prob_lo          = 0.0 0.0 0.0
grid.prob_hi          = 1000.0 1000.0 961.2758234855
grid.dz0              = 2.0
grid.stretching_ratio = 1.05
grid.max_grid_size    = 32

terrain.file = terrain_slope.csv

inflow.mode              = powerlaw
inflow.u_ref             = 8.0
inflow.v_ref             = 6.0
inflow.z_ref             = 10.0
inflow.powerlaw_exponent = 0.14

anisotropy.enable       = 1
anisotropy.source       = slope
anisotropy.alpha_h_mode = base
anisotropy.slope_scale  = 0.5
anisotropy.decay_height = 500.0

obrien.enable = 1

poisson.alpha_h       = 1.0
poisson.alpha_v       = 0.5
poisson.n_projections = 4

grid.output_format = both
grid.report_file   = grid_report_slope.txt
grid.plot_file     = plt_slope
