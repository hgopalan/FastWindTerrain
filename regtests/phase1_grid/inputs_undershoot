# Phase 1 regtest -- undershoot case
# Same dz0/stretching_ratio/nz as inputs_nominal (H_computed = 961.2758...m)
# but requested prob_hi[2] = 1200 m, i.e. GREATER than H_computed.
# Expected: FATAL abort (nonzero exit code), no report file written.

grid.n_cell           = 40 40 66
grid.prob_lo          = 0.0 0.0 0.0
grid.prob_hi          = 1000.0 1000.0 1200.0
grid.dz0              = 2.0
grid.stretching_ratio = 1.05
grid.max_grid_size    = 32
grid.report_file      = grid_report_undershoot.txt

# Phase 3 onward every run builds an inflow profile, so a reference wind
# is required even by the grid/terrain cases. These values do not affect
# what this case checks.
inflow.mode  = powerlaw
inflow.u_ref = 10.0
inflow.v_ref = 0.0
inflow.z_ref = 10.0
