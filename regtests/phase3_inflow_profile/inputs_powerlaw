# Phase 3 regtest -- power-law inflow over flat ground.
# speed(z_agl) = speed_ref * (z_agl/z_ref)^alpha, mapped onto every
# column in height above ground. Flat ground here, so z_agl == z_cc and
# the profile can be compared directly against the analytic law.

grid.n_cell           = 40 40 66
grid.prob_lo          = 0.0 0.0 0.0
grid.prob_hi          = 1000.0 1000.0 961.2758234855
grid.dz0              = 2.0
grid.stretching_ratio = 1.05
grid.max_grid_size    = 32

inflow.mode              = powerlaw
inflow.u_ref             = 8.0
inflow.v_ref             = 6.0
inflow.z_ref             = 10.0
inflow.powerlaw_exponent = 0.14

grid.output_format    = both
grid.report_file      = grid_report_powerlaw.txt
grid.plot_file        = plt_powerlaw
